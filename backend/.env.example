# Application Settings
APP_NAME=AI Product Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5174

# Server Configuration
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ai_product_assistant

# JWT & Authentication Security
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
REQUIRE_EMAIL_VERIFICATION=false

# SMTP Email Configuration (Optional in Dev - Mock Mode fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aiproductassistant.com
SMTP_FROM_NAME=AI Product Assistant
SMTP_USE_TLS=true

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:3000
